{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build C (archivo actual)",
      "type": "shell",
      "command": "gcc",
      "args": [
        "-g",
        "-Wall",
        "-Wextra",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}.exe",
        "${file}"
      ],
      "group": "build",
      "problemMatcher": "$gcc",
      "presentation": {
        "reveal": "silent"
      }
    },
    {
      "label": "build Java (archivo actual)",
      "type": "shell",
      "command": "javac",
      "args": [
        "-g",
        "-encoding",
        "UTF-8",
        "-d",
        "${workspaceFolder}/bin",
        "${file}"
      ],
      "group": "build",
      "problemMatcher": "$javac",
      "presentation": {
        "reveal": "silent"
      }
    }
  ]
}
